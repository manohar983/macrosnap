# Copy this file to secrets.toml and replace every placeholder.
GEMINI_API_KEY = "your-google-ai-studio-api-key"
GEMINI_MODEL = "gemini-3.8-flash"

TWILIO_ACCOUNT_SID = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN = "your-twilio-auth-token"
# Include whatsapp: prefix, for example "whatsapp:+14155238886"
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"
# Optional: set a saved, approved template SID (HX...) if you have one.
# Leave blank to send a free-form message during WhatsApp's 24-hour reply window.
TWILIO_CONTENT_SID = ""
